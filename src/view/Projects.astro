---
import Badge from '../components/Badge.astro';
import { projects } from './data';
---

<section id="work" aria-labelledby="work-title" class="mx-auto w-full max-w-3xl px-6 select-text">
  <div class="flex flex-col gap-1">
    <h2 id="work-title" class="text-xl font-semibold tracking-tight [text-wrap:balance] sm:text-2xl">
      Trabajo seleccionado
    </h2>
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    {
      projects.map((project, index) => (
        <article class="relative flex flex-col gap-6 rounded-lg border border-border bg-card text-card-foreground shadow-sm dark:shadow-none">
          <header class="flex flex-col gap-1.5 px-6 pt-6">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-heading text-base font-semibold leading-tight tracking-tight sm:text-lg">
                {project.title}
              </h3>
              <span
                aria-hidden="true"
                class="select-none font-heading text-[11px] font-medium tracking-[0.08em] text-muted-foreground"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <p class="text-sm text-muted-foreground">{project.description}</p>
          </header>
          <p class="-mt-3 px-6 text-sm leading-relaxed text-muted-foreground">
            {project.detail}
          </p>
          <footer class="-mt-4 mt-auto flex flex-wrap items-center gap-2 px-6 pt-6 pb-6">
            {project.stack.map((tech) => (
              <Badge variant="outline">{tech}</Badge>
            ))}
          </footer>
        </article>
      ))
    }
  </div>
</section>
