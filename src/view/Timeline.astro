---
import { timeline } from './data';
---

<section id="trayectoria" aria-labelledby="trayectoria-title" class="mx-auto max-w-3xl px-6 select-text">
  <div class="flex flex-col gap-1">
    <h2 id="trayectoria-title" class="text-xl font-semibold tracking-tight [text-wrap:balance] sm:text-2xl">
      Trayectoria
    </h2>
  </div>

  <ol class="mt-6 flex flex-col divide-y divide-border border-y border-border">
    {
      timeline.map((item) => (
        <li class="flex flex-col gap-1.5 rounded-md -mx-2 px-2 py-5 transition-colors duration-150 motion-reduce:transition-none hover:bg-muted sm:flex-row sm:gap-6">
          <span class="w-40 shrink-0 font-heading text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase">
            {item.period}
          </span>
          <div class="flex flex-col gap-1">
            <h3 class="text-base font-semibold [text-wrap:balance]">{item.title}</h3>
            {item.detail && (
              <p class="text-sm leading-relaxed text-muted-foreground">{item.detail}</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-4 font-heading text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase">
    Idiomas · Español nativo · Inglés B2 · Francés B2
  </p>
</section>
