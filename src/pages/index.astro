---
import Layout from '../layouts/Layout.astro';
import SkipLink from '../view/SkipLink.astro';
import Header from '../view/Header.astro';
import Hero from '../view/Hero.astro';
import Timeline from '../view/Timeline.astro';
import Projects from '../view/Projects.astro';
import Contact from '../view/Contact.astro';
import Footer from '../view/Footer.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Esteban Colmenares',
  jobTitle: 'Desarrollador Full-stack Web y Móvil',
  url: 'https://estebancolmenares.dev',
  email: 'mailto:estebancode91@gmail.com',
  sameAs: [
    'https://github.com/estebancolmenares91',
    'https://www.linkedin.com/in/esteban-augusto-colmenares-blanco/',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad Rafael Belloso Chacín (URBE)',
  },
  knowsLanguage: ['Español', 'Inglés', 'Francés'],
  knowsAbout: [
    'Angular',
    'React',
    'React Native',
    'Expo',
    'Flutter',
    'Node.js',
    'TypeScript',
    'TailwindCSS',
    'Web Development',
    'Mobile Development',
    'Full-stack Development',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Esteban Colmenares',
  url: 'https://estebancolmenares.dev/',
};
---

<Layout>
  <SkipLink />
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <main id="main" tabindex="-1" class="flex flex-col gap-16 pt-16 pb-24 select-none focus:outline-none sm:gap-24 sm:pt-24 sm:pb-32">
    <Hero />
    <Timeline />
    <Projects />
    <Contact />
  </main>

  <Footer />

  <script>
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
    const sections = links
      .map((link) => document.querySelector<HTMLElement>(link.hash))
      .filter((s): s is HTMLElement => s !== null);

    function setActive(id: string | null) {
      links.forEach((link) => {
        if (link.hash === `#${id}`) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    function update() {
      const threshold = window.innerHeight * 0.45;
      let current: string | null = null;

      for (const section of sections) {
        if (section.getBoundingClientRect().top <= threshold) {
          current = section.id;
        }
      }

      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8) {
        current = sections[sections.length - 1].id;
      }

      setActive(current);
    }

    if (sections.length > 0) {
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(() => {
              update();
              ticking = false;
            });
          }
        },
        { passive: true },
      );
      window.addEventListener('resize', update);
      update();
    }
  </script>
</Layout>
