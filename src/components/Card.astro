---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div
  class={`relative flex flex-col gap-6 rounded-lg border border-border bg-card text-card-foreground shadow-sm transition-colors hover:border-foreground/20 dark:shadow-none ${className}`}
>
  <slot />
</div>
