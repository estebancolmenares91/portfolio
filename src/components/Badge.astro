---
type Variant = 'default' | 'secondary' | 'outline' | 'destructive';

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-medium transition-colors focus:outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50';

const variants: Record<Variant, string> = {
  default: 'border-transparent bg-primary text-primary-foreground hover:bg-primary/80',
  secondary:
    'border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80',
  outline: 'text-foreground',
  destructive:
    'border-transparent bg-destructive/10 text-destructive hover:bg-destructive/20 dark:bg-destructive/20',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

<span class={classes}>
  <slot />
</span>
